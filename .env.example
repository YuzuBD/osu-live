# osu! live configuration.
# Copy to .env and edit. Every value is optional: with the file absent the
# program still reads the local osu! client and serves on http://<this-pc>:24051

# Interface and port. 0.0.0.0 is what makes the overlay reachable from a phone.
HOST=0.0.0.0
PORT=24051

# Where osu! keeps its beatmaps. Needed for pp; blank auto-detects.
SONGS_FOLDER=

# Memory poll interval, and how often pp is recalculated while playing.
POLL_INTERVAL_MS=50
PP_INTERVAL_MS=1000

# Optional: a bancho.py server to cross-reference rank and total pp.
# The API lives on the "api." subdomain and needs no API key.
BANCHO_API_URL=
BANCHO_PLAYER=
AVATAR_URL=
BANCHO_INTERVAL_S=15

# Optional: require ?token=… (or an Authorization header) from every client.
ACCESS_TOKEN=
